<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Scue\Menu\Api\Data\BannerSearchResultsInterface" type="Scue\Menu\Model\BannerSearchResults"/>
    <preference for="Scue\Menu\Api\BannerRepositoryInterface" type="Scue\Menu\Model\BannerRepository"/>

    <!-- TODO: rename class to be clear that it can be used for banners only -->
    <virtualType name="Scue\Menu\Model\ImageUploader" type="Magento\Catalog\Model\ImageUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">tmp/menu/banner</argument>
            <argument name="basePath" xsi:type="string">menu/banner</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
            <argument name="allowedMimeTypes" xsi:type="array">
                <item name="jpg" xsi:type="string">image/jpg</item>
                <item name="jpeg" xsi:type="string">image/jpeg</item>
                <item name="gif" xsi:type="string">image/gif</item>
                <item name="png" xsi:type="string">image/png</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Scue\Menu\Controller\Adminhtml\Banner\Upload">
        <arguments>
            <argument name="imageUploader" xsi:type="object">Scue\Menu\Model\ImageUploader</argument>
        </arguments>
    </type>
    <type name="Scue\Menu\Controller\Adminhtml\Banner\Save">
        <arguments>
            <argument name="imageUploader" xsi:type="object">Scue\Menu\Model\ImageUploader</argument>
        </arguments>
    </type>

    <!--<editor-fold desc="Menu Item: BackgroundImageUploader">-->
    <virtualType name="Scue\Menu\Model\Item\BackgroundImageUploader" type="Magento\Catalog\Model\ImageUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">tmp/menu/item/bg</argument>
            <argument name="basePath" xsi:type="string">menu/item/bg</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
            <argument name="allowedMimeTypes" xsi:type="array">
                <item name="jpg" xsi:type="string">image/jpg</item>
                <item name="jpeg" xsi:type="string">image/jpeg</item>
                <item name="png" xsi:type="string">image/png</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Scue\Menu\Controller\Adminhtml\Item\Upload">
        <arguments>
            <argument name="itemBackgroundImageUploader" xsi:type="object">Scue\Menu\Model\Item\BackgroundImageUploader</argument>
        </arguments>
    </type>
    <type name="Scue\Menu\Controller\Adminhtml\Item\Save">
        <arguments>
            <argument name="itemBackgroundImageUploader" xsi:type="object">Scue\Menu\Model\Item\BackgroundImageUploader</argument>
        </arguments>
    </type>
    <!--</editor-fold>-->
</config>

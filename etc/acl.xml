<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Scue_Menu::menu" title="Mega Menu" translate="title" sortOrder="10">
                        <resource id="Scue_Menu::items" title="Menu Items" translate="title" sortOrder="10">
                            <resource id="Scue_Menu::save" title="Save Menu Item" translate="title" sortOrder="10"/>
                            <resource id="Scue_Menu::delete" title="Delete Menu Item" translate="title" sortOrder="20"/>
                        </resource>
                        <resource id="Scue_Menu::banners" title="Banners" sortOrder="30">
                            <resource id="Scue_Menu::banner_save" title="Save Banner" translate="title" sortOrder="10"/>
                            <resource id="Scue_Menu::banner_delete" title="Delete Banner" translate="title" sortOrder="20"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
